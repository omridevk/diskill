{
  "name": "disk-clean-review",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run lint && tsc --noEmit && vite build && mv ../cli/assets/index.html ../cli/assets/page.html",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "test": "vitest run --project 'app *' && vitest run --project 'perf chromium' && vitest run --project 'perf firefox' && pnpm run frames",
    "frames": "vitest run --project 'frames chromium' && vitest run --project 'frames firefox' && vitest run --project 'frames chromium reduced' && vitest run --project 'frames firefox reduced'"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@gsap/react": "2.1.2",
    "@tanstack/charts": "0.18.0",
    "@tanstack/db": "0.11.3",
    "@tanstack/query-core": "5.104.1",
    "@tanstack/query-db-collection": "1.3.4",
    "@tanstack/react-db": "0.5.3",
    "@tanstack/react-hotkeys": "0.13.0",
    "@tanstack/react-pacer": "0.24.0",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-table": "9.2.5",
    "@tanstack/react-virtual": "3.14.13",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "d3-hierarchy": "3.1.2",
    "d3-scale": "4.0.2",
    "gsap": "3.15.0",
    "lucide-react": "1.49.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-error-boundary": "6.1.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.42",
    "@types/d3-hierarchy": "3.1.7",
    "@types/d3-scale": "4.0.9",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "5.0.3",
    "oxlint": "1.86.0",
    "playwright": "1.63.0",
    "shadcn": "4.21.1",
    "tailwindcss": "4.3.3",
